{
	admin off
	auto_https off
}

:4173 {
	root * /srv
	encode zstd gzip

	# Hashed assets never change, so they can be cached forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# SPA fallback: unknown paths (e.g. /faktury on reload) serve index.html.
	try_files {path} /index.html
	file_server
}
